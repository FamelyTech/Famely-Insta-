###############################################
# Environment Variables Example File
# Copy to .env and replace placeholder values.
# DO NOT COMMIT your real .env with secrets.
###############################################

# Django superuser (used by initial create-superuser script)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change_me_strong_password
DJANGO_SUPERUSER_EMAIL="admin@example.com"

# Example additional app user
BRIAN_USER=brian
BRIAN_PASSWORD=change_me_password

# Runtime / mode flags
PRODUCTION=0                # 1 for production, 0 for local/dev
DEBUG=true                  # Set false in production
DEBUG_POSTGRES=false        # Enable extra DB debug logging
DELETE_DB=false             # true to drop & recreate local DB (dev only)

# Django secret key (generate a new one for real usage)
# You can generate with: python -c "from django.core.management.utils import get_random_secret_key as g;print(g())"
DJANGO_SECRET="CHANGE_ME_DJANGO_SECRET_KEY"

# Networking / proxy
PROXY_1="host:port"         # e.g. "185.199.229.156:7492" or leave empty

# Third‑party / AI provider credentials (leave blank if unused)
WEBSHARE_API_KEY=""
OPENAI_API_USERNAME=""
OPENAI_API_PASSWORD=""
OPENAI_API_KEY=""
AZUREAI_KEY_1=""
AZUREAI_KEY_2=""
AZUREAI_ENDPOINT="https://<your-endpoint>.cognitiveservices.azure.com/"
AZUREAI_LOCATION="eastus"
GOOGLE_CLOUD_KEY=""
WATSON_KEY=""
HUME_KEY=""

# Notes:
# - Keep all secret values out of version control.
# - For production, ensure DEBUG=false and PRODUCTION=1.
# - Remove any unused provider keys or leave them blank.
